# ─── SERVER ENVIRONMENT VARIABLES ───────────────────────────────────────────
#
# LOCAL DEVELOPMENT — copy this to .env and fill in your values:
# PORT=5000
# MONGO_URI=mongodb://127.0.0.1:27017/flexi
# JWT_SECRET=change_this_to_a_long_random_string_in_production
# CLIENT_URL=http://localhost:5173
#
# VERCEL PRODUCTION — set these in your Vercel project dashboard:
# ➡ Dashboard → Project → Settings → Environment Variables
#
#   MONGO_URI     = mongodb+srv://<user>:<pass>@cluster.mongodb.net/edu-exchange?retryWrites=true&w=majority
#   JWT_SECRET    = <long random secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   CLIENT_URL    = https://your-project.vercel.app
#   NODE_ENV      = production
